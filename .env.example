# Auth.js session encryption. Generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth App credentials (used only to verify who is signing in).
# Create at: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:            https://danielsinensky.com
#   Authorization callback:  https://danielsinensky.com/api/auth/callback/github
# For local development, add a second callback URL on the same app:
#   http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The only GitHub username allowed to sign in to /admin.
ADMIN_GITHUB_USERNAME=danielsinensky

# Fine-grained GitHub Personal Access Token, scoped to ONLY this repo,
# with "Contents" repository permission set to Read and write.
# Create at: https://github.com/settings/personal-access-tokens/new
# Used server-side only, to commit new blog posts via the GitHub API.
GITHUB_COMMIT_TOKEN=
